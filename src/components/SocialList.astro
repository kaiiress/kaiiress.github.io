---
import { Icon } from "astro-icon/components";

const socialLinks = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/kaiiress",
		name: "mdi:github",
	},
	{
		friendlyName: "Twitter",
		link: "https://twitter.com/realjaydenr",
		name: "mdi:twitter",
	},
	{
		friendlyName: "TikTok",
		link: "https://www.tiktok.com/@realjaydenr",
		name: "mdi:tiktok",
	},
	{
		friendlyName: "Discord",
		link: "https://discord.com/users/1412637333462847598",
		name: "mdi:discord",
	},
];
---

<div class="flex flex-wrap items-end gap-x-2">
	<p>Find me on</p>
	<ul class="flex flex-1 items-center gap-x-2 sm:flex-initial">
		{
			socialLinks.map(({ friendlyName, link, name }) => (
				<li class="flex">
					<a
						class="hover:text-link inline-block"
						href={link}
						rel="noreferrer"
						target="_blank"
					>
						<Icon aria-hidden="true" class="h-8 w-8" focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
