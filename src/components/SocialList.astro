---
import { Icon } from "astro-icon/components";

const socialLinks = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/kaiiress",
		name: "mdi:github",
	},
	{
		friendlyName: "Steam",
		link: "https://steamcommunity.com/id/kaiiress/",
		name: "mdi:steam",
	},
	{
		friendlyName: "TikTok",
		link: "https://www.tiktok.com/@realjaydenr",
		name: "simple-icons:tiktok",
	},
	{
		friendlyName: "Twitch",
		link: "https://www.twitch.tv/kaiiress",
		name: "mdi:twitch",
	},
	{
		friendlyName: "YouTube",
		link: "https://www.youtube.com/@kaiiress",
		name: "mdi:youtube",
	},
	{
		friendlyName: "Discord",
		link: "https://discord.com/users/1412637333462847598",
		name: "mdi:discord",
	},
];
---

<div class="flex flex-wrap items-end gap-x-2">
	<p>Find me on</p>
	<ul class="flex flex-1 items-center gap-x-2 sm:flex-initial">
		{
			socialLinks.map(({ friendlyName, link, name }) => (
				<li class="flex">
					<a
						class="hover:text-link inline-block"
						href={link}
						rel="noreferrer"
						aria-label={friendlyName}
					>
						<Icon name={name} />
					</a>
				</li>
			))
		}
	</ul>
</div>
